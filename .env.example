# Cristae Lab runs fully offline. No environment variables are required for
# the simulator, patient profiles, diagnosis, dashboard, timeline, therapy
# pages, or CSV exports.
#
# The values below are only needed for the optional AI buttons. On Vercel,
# AI Gateway authenticates with the deployment OIDC token, so leave the key
# unset there. For local AI calls, set the key and restart the dev server.

# Server-side only. Never prefix this with VITE_.
# AI_GATEWAY_API_KEY=

# Optional model override. Must be an id from
# https://ai-gateway.vercel.sh/v1/models
# Default: openai/gpt-6-astra (text, image, and PDF).
# AI_GATEWAY_MODEL=openai/gpt-6-astra
